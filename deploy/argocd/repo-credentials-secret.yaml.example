# Copy this file to deploy/argocd/repo-credentials-secret.yaml (gitignored,
# same pattern as values-secrets.yaml) and paste in a real read-only SSH
# deploy key's private half before applying it.
apiVersion: v1
kind: Secret
metadata:
  name: cloudlite-repo-creds
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: git@github.com:aliffaizuddin/AWS.git
  sshPrivateKey: |
    CHANGE-ME-paste-the-deploy-key-private-key-here
